# 비밀 정보 (API 키)
.env

# 빌드 산출물, 하니스 작업 폴더
build*/
_deps/
llm-comparison/work/

# Python
__pycache__/
.venv/

# 대용량 산출물(녹화, 실행 파일)은 git 밖에 보관한다.
*.mp4
*.mkv
llm-comparison/runs/**/game
llm-comparison/runs-mock/

# 블라인드 채점 폴더. blind.py는 대응표를 저장소 밖에만 쓰며, 대응표는 채점이 끝난 뒤 grading/mapping.csv로 커밋한다.
blind/

# 문맥 묶음을 만들 때 내려받는 출처 저장소
llm-comparison/contexts/src/

# 성능 측정(#30): 빌드 폴더, 흐름 점검 결과, 원자료. 결과 폴더에서는 요약·그림·보고서만 커밋한다(폴더당 16개 안팎).
# 원자료(측정마다 CSV 하나, Tracy 캡처와 그 내보내기)는 수백 개라 git 밖에 보관한다(benchmark/README.md의 "원자료 보관").
benchmark/work/
benchmark/results-mock/
benchmark/results/*/raw/
benchmark/results/*/tracy/zones-*.csv
benchmark/results/*/tracy/frames-*.csv
benchmark/results/*-raw.tar.gz
*.tracy
